{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 3
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "protocol": {
          "type": "string",
          "enum": ["portfolio", "screening", "strategy"]
        },
        "permissions": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "market.prices",
              "market.assets",
              "finance.calculate",
              "finance.portfolio",
              "finance.screen",
              "finance.backtest",
              "storage.read",
              "storage.write",
              "ai.explain",
              "plugin.call"
            ]
          }
        }
      },
      "required": ["schemaVersion", "name", "protocol", "permissions"],
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "package.json": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60000
        },
        "vite.config.ts": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60000
        },
        "tsconfig.json": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60000
        }
      },
      "required": ["package.json", "vite.config.ts", "tsconfig.json"],
      "additionalProperties": {
        "type": "string",
        "maxLength": 60000
      }
    }
  },
  "required": ["manifest", "files"],
  "additionalProperties": false
}
